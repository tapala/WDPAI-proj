# Aplikacja
APP_PORT=8080

# PostgreSQL — konfiguracja kontenera db
POSTGRES_DB=db
POSTGRES_USER=docker
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Połączenie PHP -> PostgreSQL (wewnątrz sieci Dockera)
# DB_* muszą odpowiadać wartościom POSTGRES_* powyżej.
DB_HOST=db
DB_PORT=5432
DB_NAME=db
DB_USER=docker
DB_PASSWORD=change-me

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.test
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050
PGADMIN_CONTAINER_NAME=pg-admin

# Mailpit / SMTP
MAILPIT_PORT=8025
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@example.test
MAIL_FROM_NAME=WDPAI
